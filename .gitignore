# Foldory
# Keep source, lockfiles, icons, tests and Tauri config.
# Leave out installs, build output, local libraries and anything that can hold secrets.

# --- Frontend (Vite, TypeScript, npm) ---
node_modules/
dist/
dist-ssr/
.vite/
*.local
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Rust and Tauri ---
# `tauri dev` / `tauri build` compile here, including the .exe, PDBs and NSIS installer.
/src-tauri/target/
/target/
# Regenerated by the Tauri CLI for capability autocomplete.
/src-tauri/gen/schemas/
# Downloaded only when an MSI bundle is produced.
/src-tauri/WixTools/

# --- Packaged copies ---
# Local installer drop: executables, checksums and the notes written beside them.
# The repository README is the source documentation.
/releases/
*.exe
*.msi
*.msix
*.pdb

# --- Tests and local QA ---
# Playwright writes screenshots and traces here. .qa holds local fixtures,
# build logs and copies of real project folders used while checking the app.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.qa/
/coverage/
/.nyc_output/

# --- Secrets, environment and copied app data ---
# API keys belong in Windows Credential Manager, not in the repository.
# SQLite files are per-user library data (%APPDATA%\ba.reflect.foldory).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
.npmrc
.pypirc
.netrc
.aws/
.cargo/credentials*
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.kdbx
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-journal
*.db-wal
*.db-shm

# --- Operating system and editors ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump
*.suo
*.user
*.userosscache
*.sln
*.sln.docstates
.idea/
# Personal editor state stays out. A shared recommendations file can be committed.
.vscode/*
!.vscode/extensions.json
*.swp
*~
*.orig
*.log
/logs/
